# Copy to .env and fill in. Never commit .env.

# ---------- Local LLM (Ollama) ----------
OLLAMA_BASE_URL=http://localhost:11434
# long-form writing (sections, scripts)
WRITER_MODEL=qwen3:8b
# routing, reply parsing, JSON planning
FAST_MODEL=qwen3:4b
# SCRIPT_MODEL=gemma3:latest   # optional: separate model for YouTube scripts (A/B test Hindi quality)
WRITER_NUM_CTX=16384
FAST_NUM_CTX=8192
LLM_TIMEOUT_SECONDS=1800
# CPU-only laptop: keep 1. On a GPU box with OLLAMA_NUM_PARALLEL>1 you can raise it.
LLM_CONCURRENCY=1

# ---------- Email approvals ----------
# file  = dry run: emails go to data/outbox/*.eml, replies via `python -m content_agents reply RUN_ID "text"`
# gmail = real Gmail (SMTP + IMAP). Needs 2-Step Verification + an App Password, and IMAP enabled.
MAIL_BACKEND=file
SMTP_USER=your.agent.account@gmail.com
SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx
# only replies from this address are accepted
APPROVER_EMAIL=client@gmail.com
SENDER_NAME=Content Agent
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# IMAP_HOST=imap.gmail.com

# ---------- Images (all optional; missing ones are skipped) ----------
# free: https://www.pexels.com/api/
PEXELS_API_KEY=
# free: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
# Gemini image generation
GOOGLE_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Local diagrams need Graphviz:  winget install Graphviz.Graphviz

# ---------- Workflow ----------
MAX_RETRIES=3
BLOG_MIN_WORDS=2500
BLOG_MIN_SECTIONS=5
BLOG_RECENCY_DAYS=7
YT_RECENCY_DAYS=2
# ~9 minutes of narration
YT_TARGET_WORDS=1300
# hindi | english (reviewer can override per topic with LANG: ...)
SCRIPT_LANGUAGE=hindi

# ---------- Schedules (Windows Task Scheduler AND Docker `serve`) ----------
# One source of truth: scripts/register_tasks.ps1 and the Docker `serve` loop both read these.
# On Windows, re-run scripts\register_tasks.ps1 after changing them. Run the agents on ONE machine only.
# Formats: "daily 07:00", "mon 08:00", "mon,thu 09:30", "off". Missed times catch up when the machine starts.
BLOG_SCHEDULE=mon 08:00
YT_SCHEDULE=daily 07:00
POLL_MINUTES=10
TZ=Asia/Kolkata

# ---------- GPU tuning (Docker GPU laptop) ----------
# Pick WRITER_MODEL by GPU memory (VRAM):
#   6 GB  -> qwen3:8b  with WRITER_NUM_CTX=8192
#   8 GB  -> qwen3:8b
#   12-16 GB -> qwen3:14b
#   24 GB -> qwen3:32b  (or qwen3:30b-a3b)
# With 12 GB+ you can write blog sections in parallel:
# OLLAMA_NUM_PARALLEL=2
# LLM_CONCURRENCY=2
